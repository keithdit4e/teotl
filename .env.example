# Anthropic API Key
# Get your key from: https://console.anthropic.com/
# Required for running the autonomous DevOps agent
ANTHROPIC_API_KEY=sk-ant-your-key-here

# GitHub Personal Access Token
# Create with 'repo' scope: https://github.com/settings/tokens
# Or get from: gh auth token
# Required for creating pull requests
GITHUB_TOKEN=your_github_token_here

# Optional: Cost Limits (defaults shown)
# TEOTL_MAX_COST_PER_HOUR=5.0
# TEOTL_MAX_COST_PER_DAY=50.0
# TEOTL_MAX_COST_PER_MONTH=500.0
